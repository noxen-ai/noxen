# ═══════════════════════════════════════════════
# IMPORTANT: Noxen requires internet connection
# ═══════════════════════════════════════════════
# Noxen uses internet for:
#   - LLM providers (Anthropic, Google, OpenAI...)
#   - License validation (api.noxen.ai)
#   - Research Agent (GitHub, Exa, Firecrawl)
#
# Noxen will NOT start without internet access.
# This is by design — LLM providers require it.
# ═══════════════════════════════════════════════

# ─────────────────────────────────────────────────────
# Noxen v0.3.0 — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────

# ── Paths ────────────────────────────────────────────
# NOXEN_HUB_ROOT=~/Neural-Hub
# NOXEN_SKILLS_DIR=~/Neural-Hub/skills
# NOXEN_DATA_DIR=~/Neural-Hub/data

# ── Ollama / LLM (default local backend) ────────────
NOXEN_OLLAMA_BASE_URL=http://localhost:11434
NOXEN_DEFAULT_MODEL=llama3:8b
NOXEN_EMBEDDING_MODEL=nomic-embed-text

# ── Multi-LLM Providers ─────────────────────────────
NOXEN_GEMINI_API_KEY=your-gemini-api-key-here
NOXEN_GEMINI_MODEL=gemini-2.0-flash
NOXEN_CLAUDE_API_KEY=your-claude-api-key-here
NOXEN_CLAUDE_MODEL=claude-sonnet-4-20250514
NOXEN_OPENAI_API_KEY=your-openai-api-key-here
NOXEN_OPENAI_MODEL=gpt-4o

# ── Additional Providers (OpenAI-compatible) ─────────
NOXEN_GROK_API_KEY=your-grok-api-key-here
NOXEN_GROK_MODEL=grok-4
NOXEN_GROK_BASE_URL=https://api.x.ai/v1
NOXEN_MERCURY_API_KEY=your-mercury-api-key-here
NOXEN_MERCURY_MODEL=mercury-2
NOXEN_MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
NOXEN_QWEN_API_KEY=your-qwen-api-key-here
NOXEN_QWEN_MODEL=qwen3-235b-a22b
NOXEN_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Board Mode ───────────────────────────────────────
NOXEN_LLM_MODE=single
NOXEN_ACTIVE_PROVIDER=ollama
NOXEN_BOARD_CHAIRMAN=gemini

# ── MySQL (read-only analysis) ───────────────────────
NOXEN_MYSQL_HOST=localhost
NOXEN_MYSQL_PORT=3306
NOXEN_MYSQL_USER=root
NOXEN_MYSQL_PASSWORD=your-mysql-password-here
NOXEN_MYSQL_DATABASE=your-database-name-here

# ── Qdrant (vector database) ────────────────────────
NOXEN_QDRANT_URL=http://localhost:6333
NOXEN_QDRANT_API_KEY=your-qdrant-api-key-here

# ── Research Agent ───────────────────────────────────
NOXEN_GITHUB_TOKEN=your-github-token-here
NOXEN_EXA_API_KEY=your-exa-api-key-here
NOXEN_FIRECRAWL_API_KEY=your-firecrawl-api-key-here
NOXEN_RESEARCH_SANDBOX_DIR=./data/research_sandbox
NOXEN_RESEARCH_MAX_REPO_SIZE_MB=100
NOXEN_RESEARCH_CLONE_TIMEOUT_S=120

# ── Notifications ────────────────────────────────────
NOXEN_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
NOXEN_TELEGRAM_CHAT_ID=your-telegram-chat-id-here
NOXEN_SLACK_BOT_TOKEN=your-slack-bot-token-here
NOXEN_SLACK_CHANNEL_ID=your-slack-channel-id-here
NOXEN_GOOGLE_CHAT_WEBHOOK_URL=your-google-chat-webhook-url-here
NOXEN_SMTP_HOST=smtp.gmail.com
NOXEN_SMTP_PORT=587
NOXEN_SMTP_USER=your-email@gmail.com
NOXEN_SMTP_PASSWORD=your-smtp-password-here
NOXEN_SMTP_FROM=your-email@gmail.com
NOXEN_SMTP_TO=recipient@example.com
NOXEN_NOTIFICATION_TIMEOUT_H=24
NOXEN_NOTIFICATION_REMINDER_M=30

# ── Multitenant ──────────────────────────────────────
NOXEN_MULTITENANT_ENABLED=false
NOXEN_ADMIN_API_KEY=your-admin-api-key-here

# ── Server ───────────────────────────────────────────
NOXEN_HOST=0.0.0.0
NOXEN_PORT=8400
NOXEN_DEBUG=true

# ── Indexing ─────────────────────────────────────────
NOXEN_MAX_FILE_SIZE_MB=5
NOXEN_CHUNK_SIZE=1000
NOXEN_CHUNK_OVERLAP=200
NOXEN_BATCH_SIZE=50
